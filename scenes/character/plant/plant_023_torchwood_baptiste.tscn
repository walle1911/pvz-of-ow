[sub_resource type="Shader" id="Shader_matrix_depth_split"]
code = "shader_type canvas_item;

uniform float split_x : hint_range(0.0, 1.0) = 0.5;
uniform float keep_player_side : hint_range(0.0, 1.0, 1.0) = 0.0;

void fragment() {
	float player_side = 1.0 - step(split_x, UV.x);
	if (abs(player_side - keep_player_side) > 0.5) {
		discard;
	}
	COLOR = texture(TEXTURE, UV);
}"

