[sub_resource type="Shader" id="Shader_holographic_flame"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform vec4 deep_blue : source_color = vec4(0.01, 0.16, 0.56, 1.0);
uniform vec4 electric_cyan : source_color = vec4(0.18, 0.86, 1.0, 1.0);
uniform vec4 scan_color : source_color = vec4(0.68, 0.97, 1.0, 1.0);
uniform float projection_alpha : hint_range(0.0, 1.0) = 0.68;
uniform float fresnel_strength : hint_range(0.0, 2.0) = 1.15;
uniform float scan_speed : hint_range(0.05, 1.0) = 0.32;
uniform float scan_width : hint_range(0.01, 0.3) = 0.065;
uniform float grid_strength : hint_range(0.0, 0.2) = 0.028;
uniform float vertex_displacement : hint_range(0.0, 3.0) = 0.55;
uniform float glitch_displacement : hint_range(0.0, 3.0) = 0.8;

float random_2d(vec2 seed) {
	return fract(sin(dot(seed, vec2(12.9898, 78.233))) * 43758.5453);
}

void vertex() {
	float random_tick = floor(TIME * 5.0);
	float random_offset = random_2d(vec2(random_tick, UV.y * 17.0)) - 0.5;
	float tip_weight = mix(1.0, 0.28, UV.y);
	float sway = sin(TIME * 1.9 + UV.y * 4.5) * vertex_displacement * tip_weight;
	VERTEX.x += sway + random_offset * vertex_displacement * 0.12;
	VERTEX.y += sin(TIME * 1.25 + UV.x * 3.0) * vertex_displacement * 0.08;
}

void fragment() {
	float glitch_tick = floor(TIME * 3.2);
	float glitch_gate = step(0.91, random_2d(vec2(glitch_tick, 2.7)));
	float slice_id = floor(UV.y * 10.0);
	float slice_gate = step(0.7, random_2d(vec2(slice_id, glitch_tick)));
	float slice_direction = random_2d(vec2(slice_id + 4.1, glitch_tick)) * 2.0 - 1.0;
	vec2 sample_uv = UV;
	sample_uv.x += slice_direction * TEXTURE_PIXEL_SIZE.x * glitch_displacement * glitch_gate * slice_gate;
	sample_uv = clamp(sample_uv, vec2(0.0), vec2(1.0));

	vec4 tex = texture(TEXTURE, sample_uv);
	float luminance = dot(tex.rgb, vec3(0.299, 0.587, 0.114));
	float inner_light = smoothstep(0.08, 0.95, luminance);

	vec2 pixel_x = vec2(TEXTURE_PIXEL_SIZE.x, 0.0);
	vec2 pixel_y = vec2(0.0, TEXTURE_PIXEL_SIZE.y);
	float alpha_left = texture(TEXTURE, sample_uv - pixel_x).a;
	float alpha_right = texture(TEXTURE, sample_uv + pixel_x).a;
	float alpha_up = texture(TEXTURE, sample_uv - pixel_y).a;
	float alpha_down = texture(TEXTURE, sample_uv + pixel_y).a;
	vec2 alpha_gradient = vec2(alpha_right - alpha_left, alpha_down - alpha_up);
	float alpha_fresnel = smoothstep(0.045, 0.42, length(alpha_gradient)) * tex.a;
	float nearby_alpha = min(min(alpha_left, alpha_right), min(alpha_up, alpha_down));
	float silhouette_edge = clamp((tex.a - nearby_alpha) * 3.5, 0.0, 1.0);
	float fresnel = max(alpha_fresnel, silhouette_edge) * fresnel_strength;

	float scan_position = 1.12 - fract(TIME * scan_speed) * 1.24;
	float scan_distance = abs(UV.y - scan_position);
	float scan_core = exp(-pow(scan_distance / scan_width, 2.0));
	float scan_tail = exp(-pow((UV.y - scan_position - scan_width * 1.7) / (scan_width * 2.6), 2.0));

	vec2 flowing_grid_uv = UV * vec2(18.0, 22.0);
	flowing_grid_uv.y += TIME * 0.22;
	flowing_grid_uv.x += sin(UV.y * 8.0 - TIME * 0.7) * 0.08;
	vec2 grid_cell = abs(fract(flowing_grid_uv) - 0.5);
	float grid_line = max(smoothstep(0.465, 0.495, grid_cell.x), smoothstep(0.465, 0.495, grid_cell.y));
	float visible_grid = grid_line * grid_strength * (0.55 + scan_core * 2.2);

	vec2 fleck_cell = floor(UV * vec2(22.0, 26.0));
	float fleck = step(0.975, random_2d(fleck_cell + floor(TIME * 4.0)));
	fleck *= step(0.2, tex.a);

	float uv_flow = 0.5 + 0.5 * sin((UV.y * 2.2 + UV.x * 0.3 - TIME * 0.65) * 6.28318);
	vec3 hologram = mix(deep_blue.rgb, electric_cyan.rgb, 0.2 + inner_light * 0.5 + fresnel * 0.22);
	hologram = mix(hologram, scan_color.rgb, clamp(scan_core * 0.62 + visible_grid + fleck * 0.12, 0.0, 0.82));
	float brightness = 0.82 + inner_light * 0.24 + fresnel * 0.48 + scan_core * 0.38 + scan_tail * 0.08;
	brightness *= 0.97 + uv_flow * 0.06;
	float alpha = tex.a * projection_alpha * (0.72 + inner_light * 0.2);
	alpha += fresnel * 0.18 + scan_core * tex.a * 0.14 + visible_grid * tex.a;
	COLOR = vec4(hologram * brightness, clamp(alpha, 0.0, 1.0));
}"

