static func pick_available(existing_ids: Array[String]) -> String:
	if IDS.is_empty():
		return ""

	var start_index := randi_range(0, IDS.size() - 1)
	for offset in range(IDS.size()):
		var candidate := IDS[(start_index + offset) % IDS.size()]
		if not existing_ids.has(candidate):
			return candidate
	return ""
